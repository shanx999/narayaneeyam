[{"text":"പുരഃ","start":246.96,"end":247.4,"cue_id":16},{"text":" "},{"text":"ക്ലിപ്തേ","start":247.4,"end":248.48,"cue_id":17},{"text":" "},{"text":"പാദേ","start":248.48,"end":249.66,"cue_id":18},{"text":" "},{"text":"വരദ","start":249.66,"end":250.22,"cue_id":19},{"text":" "},{"text":"തവ","start":250.22,"end":250.94,"cue_id":20},{"text":" "},{"text":"നേഷ്യാമി","start":250.94,"end":252.16,"cue_id":21},{"text":" "},{"text":"ദിവസാൻ","start":252.16,"end":253.3,"cue_id":22}],"original_text":"പുരഃ ക്ലിപ്തേ പാദേ വരദ! തവ നേഷ്യാമി ദിവസാൻ","original_tokens":[{"text":"പുരഃ","cue_ids":[16]},{"text":" ","cue_ids":[]},{"text":"ക്ലിപ്തേ","cue_ids":[17]},{"text":" ","cue_ids":[]},{"text":"പാദേ","cue_ids":[18]},{"text":" ","cue_ids":[]},{"text":"വരദ","cue_ids":[19]},{"text":"! ","cue_ids":[]},{"text":"തവ","cue_ids":[20]},{"text":" ","cue_ids":[]},{"text":"നേഷ്യാമി","cue_ids":[21]},{"text":" ","cue_ids":[]},{"text":"ദിവസാൻ","cue_ids":[22]}]},{"line":4,"text":"യഥാ ശക്തി വ്യക്തം നതി-നുതി-നിഷേവാഃ വിരചയൻ","start_seconds":254.06,"end_seconds":260.3,"tokens":[{"text":"യഥാ","start":254.06,"end":254.76,"cue_id":23},{"text":" "},{"text":"ശക്തി","start":254.76,"end":255.74,"cue_id":24},{"text":" "},{"text":"വ്യക്തം","start":255.74,"end":256.62,"cue_id":25},{"text":" "},{"text":"നതി","start":256.62,"end":257.48,"cue_id":26},{"text":"-"},{"text":"നുതി","start":257.48,"end":257.84,"cue_id":27},{"text":"-"},{"text":"നിഷേവാഃ","start":257.84,"end":259.08,"cue_id":28},{"text":" "},{"text":"വിരചയൻ","start":259.08,"end":260.3,"cue_id":29}],"original_text":"യഥാശക്തി വ്യക്തം നതിനുതിനിഷേവാ വിരചയൻ","original_tokens":[{"text":"യഥാ","cue_ids":[23]},{"text":"ശക്തി","cue_ids":[24]},{"text":" ","cue_ids":[]},{"text":"വ്യക്തം","cue_ids":[25]},{"text":" ","cue_ids":[]},{"text":"നതി","cue_ids":[26]},{"text":"നുതി","cue_ids":[27]},{"text":"നിഷേവാ","cue_ids":[28]},{"text":" ","cue_ids":[]},{"text":"വിരചയൻ","cue_ids":[29]}]}]}],"meanings":[{"verse":1,"ml":"അങ്ങയുടെ നാമങ്ങൾ ജപിച്ചും രൂപം സ്മരിച്ചും ഗുണകഥകൾ പറഞ്ഞും നടക്കുന്ന ഭക്തർ ഭാഗ്യവാന്മാരാണ്. അവർ എവിടെയായാലും അങ്ങയിൽ രമിച്ച് ആനന്ദസമുദ്രത്തിൽ മുഴുകുന്നു; അവരുടെ യഥാർത്ഥ അഭിലാഷങ്ങളെല്ലാം സഫലമായിരിക്കുന്നു.","en":"Blessed indeed are devotees who chant Your names, remember Your form and tell Your glorious stories. Wherever they move, they rejoice in You, immersed in an ocean of happiness, with all their true longings fulfilled."},{"verse":2,"ml":"രോഗത്താൽ വലയുന്ന എന്റെ മനസ്സിന് അങ്ങയുടെ പാദസേവയിൽപോലും ആനന്ദം കണ്ടെത്താനാവുന്നില്ല. വിഷ്ണോ, കരുണ ചെയ്യണമേ! അങ്ങയുടെ പാദകമലങ്ങൾ സ്നേഹത്തോടെ സ്മരിച്ച് നാമങ്ങൾ പാടിക്കൊണ്ട് ഏകാന്തതയിൽ ജീവിക്കാൻ എനിക്ക് കഴിയട്ടെ.","en":"Illness has so troubled my mind that it finds no delight even in serving Your feet. Vishnu, have mercy! Let me live in solitude, lovingly remembering Your lotus feet and singing Your many names."},{"verse":3,"ml":"അങ്ങയുടെ കൃപയുണ്ടെങ്കിൽ ജീവികൾക്ക് ലഭിക്കാത്തതായി എന്തുണ്ട്? എന്റെ ദുഃഖങ്ങൾ നീക്കുന്നത് അങ്ങയ്ക്ക് എത്ര ചെറുതാണ്! ആസക്തിയും ശോകവും വിട്ട എത്രയോ ഭക്തർ അങ്ങ് നൽകുന്ന സ്വാതന്ത്ര്യത്തിൽ സന്തോഷത്തോടെ ജീവിക്കുന്നു.","en":"What is beyond reach when Your grace arises? Removing my suffering is surely little for You. So many devotees in this world, free from attachment and sorrow, move happily in the freedom You bestow."},{"verse":4,"ml":"നാരദൻ മുതലായ മഹാമുനികൾ ലോകത്ത് സ്വതന്ത്രരായി സഞ്ചരിക്കുന്നു; അവരുടെ ആന്തരികനില സാധാരണക്കാർക്ക് അജ്ഞാതമാണ്. അങ്ങയുടെ പാദസ്മരണം അവരെ ക്ലേശമുക്തരാക്കുന്നു. നിത്യമായി പ്രകാശിക്കുന്ന പരബോധത്തിന്റെ അദ്വൈതാനന്ദത്തിൽ അവർ മുഴുകുന്നു.","en":"Great sages such as Narada, whose inner state is hidden from ordinary sight, move freely through the world. Remembrance of Your feet frees them from affliction; they remain immersed in the ever-shining, undivided bliss of supreme consciousness."},{"verse":5,"ml":"അങ്ങയോടുള്ള ഭക്തി എന്നിൽ ശക്തമായി വളരട്ടെ. അത് എല്ലാ ക്ലേശങ്ങളും ശമിപ്പിക്കുമെന്നതിൽ എനിക്ക് സംശയമില്ല. അല്ലെങ്കിൽ വ്യാസവചനവും അങ്ങയുടെ ഉപദേശവും വേദവാക്യവും സാധാരണ വഴിവർത്തമാനംപോലെ വിശ്വസിക്കാനാവാത്തതാകും.","en":"Let devotion to You grow strong in me. I have no doubt that it can calm every suffering. Otherwise the words of Vyasa, Your own teaching and the Vedas would be as unreliable as idle street talk."},{"verse":6,"ml":"അങ്ങയുടെ ഗുണമാധുര്യത്താൽ ഭക്തി തുടക്കത്തിലേ മധുരമാണ്. വളരുമ്പോൾ അത് എല്ലാ താപങ്ങളും ശമിപ്പിക്കുന്നു. ഒടുവിൽ നിർമ്മലജ്ഞാനം ഉദിച്ച് അദ്വൈതമായ മഹാനന്ദം നൽകുന്നു. ഇതിലും വലിയ എന്താണ് ഞാൻ പ്രാർത്ഥിക്കേണ്ടത്?","en":"Devotion is sweet from the beginning because of Your virtues. As it deepens, it removes distress; at its fulfilment, pure understanding dawns and grants undivided supreme bliss. What greater blessing could I ask?"},{"verse":7,"ml":"എന്റെ ക്ലേശങ്ങൾ നീക്കി, അങ്ങയുടെ ക്ഷേത്രത്തിലെത്താൻ കാലുകൾക്കും പൂജിക്കാൻ കൈകൾക്കും രൂപം കാണാൻ കണ്ണുകൾക്കും പാദതുളസിയുടെ സുഗന്ധം നുകരാൻ മൂക്കിനും മനോഹരകഥകൾ കേൾക്കാൻ കാതുകൾക്കും ആനന്ദം നൽകണമേ.","en":"Remove my suffering and let my feet delight in reaching Your temple, my hands in worship, my eyes in seeing Your form, my nose in the fragrance of tulasi at Your feet, and my ears in Your beautiful stories."},{"verse":8,"ml":"മാനസികവും ശാരീരികവുമായ വേദനകളാൽ കലങ്ങിയ എന്റെ ഹൃദയത്തിൽ പരമാനന്ദബോധസ്വരൂപമായ അങ്ങയുടെ രൂപം ഉദിക്കട്ടെ. രോമാഞ്ചവും ഒഴുകുന്ന ആനന്ദാശ്രുക്കളും ഈ കഠിനദുഃഖത്തിന്റെ പീഡനം മറക്കാൻ എന്നെ സഹായിക്കട്ടെ.","en":"Let Your form, made of supreme bliss and consciousness, arise in my heart, shaken by mental and bodily pain. May rapture and flowing tears of joy make me forget the oppression of this stubborn suffering."},{"verse":9,"ml":"ഗുരുവായൂരപ്പാ, അങ്ങയിൽനിന്ന് അകന്നവർപോലും സന്തോഷിക്കുന്നു; അങ്ങയെ സ്നേഹിക്കുന്ന ഞാൻ ഏറെ കഷ്ടപ്പെടുന്നു. ഇത് അങ്ങയ്ക്ക് അപകീർത്തിയാകാതിരിക്കട്ടെ. രോഗഭാരം നീക്കി, ഭക്തരിൽ ഒരു ഭൂഷണമായി എന്നെ വേഗം മാറ്റണമേ.","en":"Lord of Guruvayur, even those who turn away from You live happily, while I, who love You, suffer greatly. Let this bring You no reproach: relieve my illness and swiftly make me an ornament among Your devotees."},{"verse":10,"ml":"അങ്ങയുടെ കരുണ ഉദിക്കുന്നതുവരെ ദുഃഖം നിറഞ്ഞ ഈ പ്രാർത്ഥനകൾ ഞാൻ തുടരും. അങ്ങയുടെ പാദസന്നിധിയിൽ, കഴിയുന്നത്ര നമസ്കരിച്ചും സ്തുതിച്ചും സേവിച്ചും എന്റെ ദിവസങ്ങൾ കഴിച്ചുകൂട്ടും.","en":"Until Your compassion dawns, I shall continue these many cries of distress. Before Your feet I will spend my days, bowing, praising and serving as fully as my strength allows."}],"duration_seconds":265.673,"edition":"Review edition: OCR corrected and cross-checked with Sanskrit references; automatic alignment with targeted repairs. Full listening and scholarly review remain welcome."}