ens":[{"text":"അർചിഃ","start":221.52,"end":222.1,"cue_id":0},{"text":" "},{"text":"ആദിഗതിം","start":222.1,"end":223.12,"cue_id":1},{"text":"-"},{"text":"ഈദൃശീം","start":223.12,"end":224.02,"cue_id":2},{"text":" "},{"text":"വ്രജൻ","start":224.02,"end":224.68,"cue_id":3}],"original_text":"അർച്ചിരാദിഗതിമീദൃശീം വ്രജൻ","original_tokens":[{"text":"അർച്ചി","cue_ids":[0]},{"text":"രാ","cue_ids":[0,1]},{"text":"ദിഗതി","cue_ids":[1]},{"text":"മീ","cue_ids":[1,2]},{"text":"ദൃശീം","cue_ids":[2]},{"text":" ","cue_ids":[]},{"text":"വ്രജൻ","cue_ids":[3]}]},{"line":2,"text":"വിച്യുതിം ന ഭജതേ ജഗത്പതേ","start_seconds":225.22,"end_seconds":228.16,"tokens":[{"text":"വിച്യുതിം","start":225.22,"end":226.04,"cue_id":4},{"text":" "},{"text":"ന","start":226.04,"end":226.26,"cue_id":5},{"text":" "},{"text":"ഭജതേ","start":226.26,"end":227.0,"cue_id":6},{"text":" "},{"text":"ജഗത്പതേ","start":227.0,"end":228.16,"cue_id":7}],"original_text":"വിച്യുതിം ന ഭജതേ ജഗത്പതേ!","original_tokens":[{"text":"വിച്യുതിം","cue_ids":[4]},{"text":" ","cue_ids":[]},{"text":"ന","cue_ids":[5]},{"text":" ","cue_ids":[]},{"text":"ഭജതേ","cue_ids":[6]},{"text":" ","cue_ids":[]},{"text":"ജഗത്പതേ","cue_ids":[7]},{"text":"!","cue_ids":[]}]},{"line":3,"text":"സച്ചിദാത്മക ഭവത് ഗുണ-ഉദയാൻ","start_seconds":228.64,"end_seconds":232.3,"tokens":[{"text":"സച്ചിദാത്മക","start":228.64,"end":229.72,"cue_id":8},{"text":" "},{"text":"ഭവത്","start":229.72,"end":231.04,"cue_id":9},{"text":" "},{"text":"ഗുണ","start":231.04,"end":231.34,"cue_id":10},{"text":"-"},{"text":"ഉദയാൻ","start":231.34,"end":232.3,"cue_id":11}],"original_text":"സച്ചിദാത്മക! ഭവദ്ഗുണോദയാ-","original_tokens":[{"text":"സച്ചിദാത്മക","cue_ids":[8]},{"text":"! ","cue_ids":[]},{"text":"ഭവ","cue_ids":[9]},{"text":"ദ്ഗു","cue_ids":[9,10]},{"text":"ണോ","cue_ids":[10,11]},{"text":"ദയാ","cue_ids":[11]},{"text":"-","cue_ids":[]}]},{"line":4,"text":"ഉച്ചരന്തം അനിലേശ പാഹി മാം","start_seconds":232.68,"end_seconds":236.26,"tokens":[{"text":"ഉച്ചരന്തം","start":232.68,"end":233.8,"cue_id":12},{"text":" "},{"text":"അനിലേശ","start":233.8,"end":234.96,"cue_id":13},{"text":" "},{"text":"പാഹി","start":234.96,"end":235.82,"cue_id":14},{"text":" "},{"text":"മാം","start":235.82,"end":236.26,"cue_id":15}],"original_text":"നുച്ചരന്തമനിലേശ! പാഹി മാം","original_tokens":[{"text":"നു","cue_ids":[11,12]},{"text":"ച്ചരന്ത","cue_ids":[12]},{"text":"മ","cue_ids":[12,13]},{"text":"നിലേശ","cue_ids":[13]},{"text":"! ","cue_ids":[]},{"text":"പാഹി","cue_ids":[14]},{"text":" ","cue_ids":[]},{"text":"മാം","cue_ids":[15]}]}]}],"meanings":[{"verse":1,"ml":"അങ്ങയെ ഉപാസിക്കാൻ കഴിയുന്നത്ര ആരോഗ്യം എനിക്ക് നൽകണമേ. യോഗത്തിന്റെ എട്ട് അംഗങ്ങളും സ്ഥിരമായി അഭ്യസിച്ച് അങ്ങയുടെ പ്രീതി വേഗം നേടാൻ എനിക്ക് കഴിയട്ടെ.","en":"Grant me enough health to worship You. Through steady practice of the eight limbs of yoga, may I soon win Your grace."},{"verse":2,"ml":"ബ്രഹ്മചര്യം മുതലായ യമങ്ങളും ശുചിത്വം മുതലായ നിയമങ്ങളുംകൊണ്ട് ശുദ്ധരായി, അങ്ങയിൽ മനസ്സുറപ്പിച്ച് സുഖാസനത്തിലോ പത്മാസനത്തിലോ ഞങ്ങൾ സ്ഥിരമായി ഇരിക്കുന്നു.","en":"Purified by restraints such as chastity and observances such as cleanliness, we turn wholly to You and sit steadily in a comfortable posture, such as the lotus seat."},{"verse":3,"ml":"മനസ്സിൽ ഓംകാരത്തെ നിരന്തരം ധ്യാനിച്ച് ശ്വാസത്തെ നിയന്ത്രിച്ച് ഞങ്ങൾ ശുദ്ധരാകുന്നു. വിഷയങ്ങളിൽനിന്ന് ഇന്ദ്രിയങ്ങളെ പിൻവലിച്ച് അങ്ങയുടെ അന്തരംഗോപാസനയ്ക്ക് സജ്ജരാകുന്നു.","en":"Silently contemplating Om, we regulate the breath and purify ourselves. Drawing the senses away from their objects, we become ready to worship You inwardly."},{"verse":4,"ml":"ആദ്യം മനസ്സിൽ അങ്ങയുടെ രൂപം വ്യക്തമല്ലെങ്കിലും വീണ്ടും വീണ്ടും ശ്രദ്ധ അതിൽ ഉറപ്പിക്കുന്നു. അങ്ങയുടെ പാദങ്ങൾ സ്മരിക്കുമ്പോൾ ഭക്തിയുടെ മാധുര്യംകൊണ്ട് ഞങ്ങളുടെ ഹൃദയം ആർദ്രമാകട്ടെ.","en":"Though Your form is at first indistinct within the mind, we repeatedly fix our attention on it. Remembering Your feet, may we develop the tender inward sweetness of devotion."},{"verse":5,"ml":"ദീർഘമായ അഭ്യാസത്താൽ അങ്ങയുടെ രൂപത്തിലെ ഓരോ മനോഹരമായ അവയവവും തെളിയുന്നു. അങ്ങയെ ആശ്രയിച്ച് ധ്യാനത്തിൽ മുഴുകുമ്പോൾ ആ രൂപത്തെ പ്രയാസമില്ലാതെ മനസ്സിൽ കാണാൻ കഴിയുന്നു.","en":"With long practice, every beautiful feature of Your form becomes clear. Relying on You and absorbed in meditation, we contemplate it effortlessly."},{"verse":6,"ml":"അങ്ങയുടെ പൂർണ്ണരൂപം ധ്യാനിക്കുമ്പോൾ അതിന്റെ വെളിപ്പെടുന്ന മാധുര്യത്തിൽ മനസ്സ് ലയിക്കുന്നു. അപ്പോൾ ആനന്ദസാന്ദ്രമായ അങ്ങയുടെ അന്തരംഗബ്രഹ്മസ്വരൂപം പ്രകാശിക്കുന്നു.","en":"As we meditate on this complete form, its unfolding sweetness carries the mind away. Then Your inner reality, Brahman, shines as concentrated bliss."},{"verse":7,"ml":"വിശ്വനാഥാ, ആ പരമതത്ത്വത്തെ അനുഭവിക്കുന്ന സമാധിനിലയിൽ ഞങ്ങൾ പ്രവേശിക്കുന്നു. അതിൽനിന്ന് മനസ്സ് വഴുതുമ്പോൾ ധാരണ മുതലായ അഭ്യാസങ്ങൾ വീണ്ടും ആരംഭിക്കുന്നു.","en":"Lord of the universe, we enter samadhi, the absorbed state of tasting that reality. Whenever we fall away from it, we begin again with concentration and the succeeding stages."},{"verse":8,"ml":"ഇങ്ങനെ തുടർച്ചയായി അഭ്യസിക്കുമ്പോൾ അങ്ങയുടെ പരമാത്മാനന്ദം നിത്യോത്സവമായി മാറുന്നു. ശുകനെയും നാരദനെയുംപോലെ മുക്തഭക്തരിൽ ശ്രേഷ്ഠരായി ഞങ്ങൾ സഞ്ചരിക്കട്ടെ.","en":"Through such sustained practice, the joy of Your supreme Self becomes a constant celebration. May we move like Shuka and Narada, foremost among liberated devotees."},{"verse":9,"ml":"സമാധിയിൽ ഉറച്ച യോഗി ഉടനെയോ ക്രമേണയോ മോക്ഷം ആഗ്രഹിച്ച്, യോഗത്താൽ നിയന്ത്രിച്ച പ്രാണവായുവിനെ സുഷുമ്ന എന്ന മധ്യനാഡിയിലൂടെ ആറു കേന്ദ്രങ്ങൾ കടത്തി സാവധാനം ഉയർത്തുന്നു.","en":"The yogi established in samadhi, seeking immediate or gradual liberation, gently raises the controlled life-breath through the six centres along the central channel, sushumna."},{"verse":10,"ml":"മറ്റൊരു ആഗ്രഹവുമില്ലാത്ത യോഗി സൂക്ഷ്മശരീരംപോലും ഉപേക്ഷിച്ച് അങ്ങയിൽ ലയിക്കുന്നു. ഉയർന്ന ലോകങ്ങൾ അനുഭവിക്കാൻ ആഗ്രഹിക്കുന്നവൻ സൂക്ഷ്മമായ ഇന്ദ്രിയശക്തികളോടൊപ്പം ശിരസ്സിലൂടെ പുറപ്പെടുന്നു.","en":"One without further desire abandons even the subtle body and merges in You. One wishing to experience higher worlds leaves through the crown, carrying the subtle faculties along."},{"verse":11,"ml":"അഗ്നി, പകൽ, ശുക്ലപക്ഷം, ഉത്തരായനം എന്നിവയുടെ ദേവതകൾ നയിക്കുന്ന ഭക്തൻ സൂര്യമണ്ഡലത്തിലെത്തി ആനന്ദത്തോടെ ധ്രുവപദത്തിലേക്ക് മുന്നേറുന്നു.","en":"Led by the deities of fire, daylight, the bright fortnight and the sun's northern course, the devotee reaches the solar realm and joyfully proceeds towards Dhruva's station."},{"verse":12,"ml":"മഹർലോകത്തിൽ വസിക്കുന്ന യോഗിയെ ശേഷന്റെ മുഖങ്ങളിൽനിന്നുള്ള പ്രളയാഗ്നിയുടെ ചൂട് ബാധിക്കുമ്പോൾ ബ്രഹ്മലോകത്തിലേക്ക് പോകുന്നു. അങ്ങയുടെ ആശ്രയത്താൽ അതിനുമുമ്പും അവിടെ എത്താം.","en":"Dwelling in Maharloka, the yogi is eventually touched by the heat of the fire from Shesha's mouths and moves to Brahma's realm; by taking refuge in You, this ascent may happen even earlier."},{"verse":13,"ml":"ബ്രഹ്മലോകത്തിലോ അങ്ങയുടെ ദിവ്യപദത്തിലോ വസിച്ച് പ്രാകൃതപ്രളയത്തിൽ യോഗി അന്തിമമുക്തി നേടുന്നു. ആഗ്രഹിച്ചാൽ അതിനുമുമ്പുതന്നെ ബ്രഹ്മാണ്ഡത്തിന്റെ ആവരണം ഭേദിച്ച് മുക്തനാകാം.","en":"Remaining in Brahma's realm or Your divine abode, the yogi attains final freedom at cosmic dissolution. By choice, liberation may come earlier through piercing the cosmic enclosure."},{"verse":14,"ml":"ഭൂമി, ജലം, അഗ്നി, വായു, ആകാശം, മഹത്തത്ത്വം, പ്രകൃതി എന്നീ ഏഴ് ആവരണങ്ങളിലൂടെ അതാതിന്റെ സ്വഭാവം പ്രാപിച്ച് കടന്നുപോകുന്ന യോഗി, ഒടുവിൽ മറകളില്ലാത്ത അങ്ങയുടെ പദം പ്രാപിക്കുന്നു.","en":"Passing successively through the seven coverings—earth, water, fire, air, space, the cosmic intelligence and primordial Nature—the liberated traveller transcends them and reaches Your unobstructed presence."},{"verse":15,"ml":"ഈ പ്രകാശമാർഗ്ഗത്തിലൂടെ സഞ്ചരിക്കുന്നവർ തിരിച്ചുവീഴുന്നില്ല. സച്ചിദാത്മാവായ ഗുരുവായൂരപ്പാ, അങ്ങയുടെ ഗുണമഹിമകൾ പാടിക്കൊണ്ടിരിക്കുന്ന എന്നെ കാത്തരുളണമേ.","en":"Those who follow this path of light do not fall back. Lord of Guruvayur, whose nature is existence and consciousness, protect me as I sing of Your glorious qualities."}],"duration_seconds":239.416,"edition":"Review edition: OCR corrected and cross-checked with Sanskrit references; automatic alignment with targeted repairs. Full listening and scholarly review remain welcome."}